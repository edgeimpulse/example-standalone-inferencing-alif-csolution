{
    "files.associations": {
        "*.h": "c",
    },

    "cmake.configureOnOpen": false,

    "cortex-debug.variableUseNaturalFormat": false,
    "cmsis-csolution.actions": [
        {
            "path": "firmware-alif.csolution.yaml",
            "target": "HE",
            "config": {
                "debug": "Alif Ensemble Debug (Cortex-Debug)"
            }
        },
        {
            "path": "firmware-alif.csolution.yaml",
            "target": "HP",
            "config": {
                "debug": "Alif Ensemble Debug (Cortex-Debug)"
            }
        },
        {
            "path": "firmware-alif.csolution.yaml",
            "target": "HP_SRAM",
            "config": {
                "debug": "Alif Ensemble Debug (Cortex-Debug)"
            }
        }
    ],
    "debug.hideSlowPreLaunchWarning": true,
    "debug.showInStatusBar": "never",
    "clangd.arguments": [
        "--compile-commands-dir=/Users/francescovarani/work/edge_impulse/alif/example-standalone-inferencing-alif-csolution/out/firmware-alif/HE/Debug"
    ],
}